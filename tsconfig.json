{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // .next/types/validator.ts is generated by Next 15.5 and hardcodes app paths
  // without the "src" segment (it emits ../../app/... for a src/app project),
  // so it cannot resolve our pages. Upstream bug: vercel/next.js#82877.
  // The per-route shims in .next/types/app/**/page.ts resolve correctly and
  // still type-check every page, so only the broken file is excluded.
  "exclude": ["node_modules", ".next/types/validator.ts"]
}
